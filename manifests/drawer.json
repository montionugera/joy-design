{
  "component": "Drawer",
  "targets": {
    "react": "JoyDrawer",
    "svelte": "Drawer",
    "flutter": "JoyDrawer"
  },
  "variants": ["right", "left"],
  "props": {
    "open": { "type": "boolean", "default": false },
    "title": { "type": "string" },
    "placement": {
      "type": "enum",
      "values": ["right", "left"],
      "default": "right"
    },
    "closable": { "type": "boolean", "default": true }
  },
  "events": {
    "close": {
      "react": "onClose",
      "svelte": "onclose",
      "flutter": "onClose"
    }
  },
  "slots": {
    "content": {
      "react": "children",
      "svelte": "children",
      "flutter": "content"
    },
    "footer": {
      "react": "footer",
      "svelte": "footer",
      "flutter": "footer"
    }
  }
}
